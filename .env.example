# ДомКруг — пример переменных окружения
# Скопируйте в .env (в корне репозитория) и при необходимости измените.
# .env НИКОГДА не коммитить — он в .gitignore.

# ─── Приложение ───────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
# Слушать только loopback: наружу смотрит Caddy, а не Node.
APP_HOST=127.0.0.1
APP_URL=http://localhost:3000
# Для отдельного api-поддомена — явный список через запятую.
# CORS_ORIGINS=https://liviti.ru,https://app.liviti.ru,https://uk.liviti.ru
LOG_LEVEL=info

# ─── PostgreSQL (docker compose) ──────────────────────────
POSTGRES_USER=domkrug
POSTGRES_PASSWORD=domkrug_dev_password
POSTGRES_DB=domkrug_dev
POSTGRES_PORT=5432

# Строка подключения для приложения и миграций.
# Должна совпадать с POSTGRES_* выше.
DATABASE_URL=postgresql://domkrug:domkrug_dev_password@localhost:5432/domkrug_dev

# ─── Авторизация ──────────────────────────────────────────
# Обязателен, минимум 32 символа. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Не оставляйте значение из примеров: сервер откажется стартовать.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Отдельный секрет для HMAC-индекса гостевых кодов. Если пусто — JWT_SECRET.
# CODE_SECRET=
# Отдельный ключ обратимого шифрования кодов/секретов. Если пусто — JWT_SECRET.
# DATA_ENCRYPTION_KEY=
# Только для локального стенда, если осознанно нужна заглушка:
# ALLOW_INSECURE_DEV_SECRET=true

# Домен refresh-cookie. В production для поддоменов: .liviti.ru
# Пусто — cookie привязана к текущему хосту (безопасный вариант по умолчанию).
COOKIE_DOMAIN=

# ─── Файлы ────────────────────────────────────────────────
# Локальный каталог фото/документов заявок (S3 в текущей версии не используется).
STORAGE_DIR=./uploads

# AMI и вызывная панель — см. ниже.

# --- Звонки с вызывной панели (Asterisk AMI) ---
# Выключено по умолчанию: без настроенного Asterisk бэкенд не стучится в порт.
# AMI слушает только 127.0.0.1 — наружу его не выставлять.
AMI_ENABLED=false
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=
AMI_PASSWORD=

# ─── Устройство доступа (вызывная панель Hikvision, ISAPI) ────────────────
# Пустой ACCESS_VENDOR_HOST = устройство не подключено, работает mock-провайдер.
# Хост без схемы — подставится http:// (для https:// укажите схему явно).
ACCESS_VENDOR_HOST=
ACCESS_VENDOR_USER=
ACCESS_VENDOR_PASSWORD=
# Сколько секунд замок держится открытым (панель этого не сообщает).
ACCESS_VENDOR_HOLD_SECONDS=5
# Таймаут запроса к панели, мс.
ACCESS_VENDOR_TIMEOUT_MS=5000
