{
  "name": "domkrug-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ДомКруг — backend (Fastify + PostgreSQL)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "migrate": "tsx src/db/migrate.ts",
    "db:backfill-code-lookup": "tsx src/db/backfill-code-lookup.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed-demo-readings": "tsx src/db/seed-demo-readings.ts",
    "db:reset": "tsx src/db/reset.ts",
    "check:text": "tsx src/db/check-text.ts",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:api": "vitest run tests/api",
    "test:watch": "vitest tests/unit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.6",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
